# Токен вашого Telegram-бота від @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID адміністраторів через кому (наприклад: 12345678,98765432)
# Дізнатися свій ID можна в боті @userinfobot
ADMIN_IDS=123456789,987654321

# ID цільової групи або каналу, куди надсилати пости
# (наприклад: -1001234567890 або @my_channel_username)
# Бот повинен бути доданий у цю групу/канал як адміністратор з правом публікації
TARGET_CHAT_ID=-1001234567890

# Рядок підключення до бази даних (за замовчуванням автономна SQLite)
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Інтервал перевірки БД на наявність нових товарів (у секундах)
DB_CHECK_INTERVAL_SECONDS=60

# Юзернейм адміна для замовлень та зв'язку з покупцями (наприклад: sales_manager або @sales_manager)
# Бот додасть кнопку-посилання в кінці кожного опублікованого посту
MANAGER_USERNAME=sales_manager
